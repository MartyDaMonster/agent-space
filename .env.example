# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Accept the request host. Set true on Vercel so preview URLs can sign in.
AUTH_TRUST_HOST=true

# GitHub OAuth app. Callback: https://YOUR_HOST/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub App that creates one private repo per invitee. Leave unset to skip repo creation.
# Callback: https://YOUR_HOST/api/github/callback
# Permissions, that repo only: Contents, Issues, and Pull requests read/write. Account: read the username.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Google OAuth client. Callback: https://YOUR_HOST/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated. Unset uses the two addresses below. An explicit empty value refuses every email.
ALLOWED_EMAILS=marty.hungerford3181@gmail.com,marty.j.hungerford@gmail.com

# Numeric GitHub user ids that are owners. Unset allows 150204025 (MartyDaMonster).
ALLOWED_GITHUB_IDS=150204025

# Public origin used in invite links. Never taken from the request host.
APP_ORIGIN=https://botomatic.dev

# Neon Postgres connection string, pooled. From the Vercel Marketplace Neon integration.
DATABASE_URL=

# Optional. Salts the daily login-page visitor hash. Unset uses AUTH_SECRET.
METRICS_SALT=

# Private Vercel Blob store. When set, file uploads use it. Without it, files of 4MB or less are stored in Neon.
BLOB_READ_WRITE_TOKEN=

# Required for the daily file-expiry cron. Vercel sends Authorization: Bearer <this value>.
CRON_SECRET=

# Resend API key for invite email. Without it, invites are still created and the admin page says to copy the link.
RESEND_API_KEY=

# From address. The domain must be verified in Resend before mail leaves the sandbox.
INVITE_FROM=Botomatic <invites@botomatic.dev>
