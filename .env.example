# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Accept the request host. Set true on Vercel so preview URLs can sign in.
AUTH_TRUST_HOST=true

# GitHub OAuth app. Callback: https://YOUR_HOST/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client. Callback: https://YOUR_HOST/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated. Anyone else is refused at sign-in. Empty refuses everyone.
ALLOWED_EMAILS=marty.hungerford3181@gmail.com,marty.j.hungerford@gmail.com

# Neon Postgres connection string, pooled. From the Vercel Marketplace Neon integration.
DATABASE_URL=

# Optional private Vercel Blob store. Files are never public.
# Without this, files up to 4MB are stored in Neon instead.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
